# Database: local SQLite file for dev, or a Turso URL (libsql://...) in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Long random string (openssl rand -hex 32)
SESSION_SECRET=

# Password for /admin
ADMIN_PASSWORD=

# Public URL of this championship (used in certificate QR codes, so never change it after results)
NEXT_PUBLIC_SITE_URL=https://kudoscup.com

# Emails via Resend (leave empty to log emails instead of sending them)
RESEND_API_KEY=
# EMAIL_FROM="Kudos Cup <noreply@kudoscup.com>"
# EMAIL_REPLY_TO=hello@kudoscup.com

# UPI details for the ₹10 payment QR
UPI_ID=yourname@okhdfcbank
UPI_PAYEE_NAME="Kudos Cup"

# Never true in production
EXAM_TEST_MODE=false
